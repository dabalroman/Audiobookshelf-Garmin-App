<?xml version="1.0"?>
<!-- Beta build for the uploader's own watch (scripts\build.ps1 -Beta N): own app id and name, so it
     never collides with the store's Audiobooks Green. Keep permissions / languages in step with
     manifest.xml. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="4c5be1ff-dbdb-4a29-9439-59bc469889da" type="audio-content-provider-app" name="@Strings.AppNameBeta" entry="AbooksApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0">
        <iq:products>
            <iq:product id="fr970"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="ComplicationPublisher"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>rus</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
